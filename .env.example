# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/agent-factory

# Admin (REQUIRED - server won't start without these)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Admin

# Encryption (for sensitive data like provider API keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-key-change-in-production

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seeding
# Automatically seed/update system agents (Agent Creator, Default) on startup
SEED_SYSTEM_AGENTS_ON_START=true

# JS Node Sandbox Limits
JS_NODE_DEFAULT_TIMEOUT_MS=5000
JS_NODE_MAX_TIMEOUT_MS=30000
JS_NODE_DEFAULT_MEMORY_MB=64
JS_NODE_MAX_MEMORY_MB=256
